<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- market-analysis weekly loader (docs/OPERATING.md §1): FINRA short interest, full universe, Saturday 09:00 local.
       launchd runs the job on wake if the Mac was asleep at 09:00. Install: launchctl bootstrap gui/$(id -u) <this file>. -->
  <key>Label</key><string>com.market-analysis.loaders-weekly</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>cd /Users/ewan/Development/market-analysis &amp;&amp; /usr/bin/make -s loaders-weekly >> data/logs/loaders.log 2>&amp;1</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/Users/ewan/.pyenv/shims:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME</key><string>/Users/ewan</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict><key>Weekday</key><integer>6</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardErrorPath</key><string>/Users/ewan/Development/market-analysis/data/logs/launchd-loaders-weekly.err</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
