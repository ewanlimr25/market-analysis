     "description": "sizing basis x contracts"
    },
    "straddle_over_implied": {
     "type": "number"
    },
    "exit_tier_max": {
     "type": [
      "integer",
      "null"
     ]
    },
    "entry_tier_max": {
     "type": "integer"
    },
    "model_exit": {
     "type": [
      "boolean",
      "null"
     ]
    },
    "model_entry": {
     "type": "boolean"
    },
    "dte": {
     "type": "integer",
     "description": "sessions from pre to expiry"
    },
    "legs_json": {
     "type": "string",
     "description": "JSON list of leg records (engine.strategies.sa_structures.leg_record)"
    },
