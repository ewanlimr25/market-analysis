{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "engine-daily signals (d1.1)",
 "description": "The machine copy of one `make daily` run (analyses/daily/<date>/signals.json; DESIGN/70 \u00a75, DESIGN/80 \u00a77). Deterministic engine output, no model. Every object is strict (additionalProperties false) so a consumer can detect drift. Sizing fields (contracts and every *_usd) are the redaction class for public surfaces (findings DESIGN/95 \u00a74). `n` in the running tables is a count of positions; contracts are always `contracts`. d1.1 (2026-09-06): policy_id/role/gate_verdict on positions, the S-B exploration book, ledger_counts.exploration_*. d1.2 (2026-09-08, DESIGN/110 R2): optional top-level watch_basket object (exploration-only, paper rows, policy wb-1.0); ledger_counts.wb_emitted/wb_graded. d1.3 (2026-09-07 evening, DESIGN/110 \u00a72/\u00a78): C-DIV-D (daily RSI bullish divergence) added to the watch-basket conditions, widening watch_basket.count_distribution.bull's bound from 0..6 to 0..7; key \"7\" is optional (not required) so d1.2 documents, which never emit it, stay valid. d1.4 (2026-09-07 evening, DESIGN/110 \u00a72/\u00a78): C-POC-A and C-POC-A-LOSS (anchored volume-profile acceptance) added to the watch-basket conditions, widening watch_basket.count_distribution.bull's bound to 0..8 and .bear's bound to 0..8; keys \"8\" (bull) and \"8\" (bear) are optional (not required) so d1.0-d1.3 documents, which never emit them, stay valid.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema_version",
  "report_kind",
  "date",
  "season",
  "preflight",
  "mart",
  "candidates",
  "suppressed",
  "dropped",
  "graded",
  "season_running",
  "ledger",
  "sb_state"
 ],
 "properties": {
  "schema_version": {
   "enum": [
    "d1.0",
    "d1.1",
    "d1.2",
    "d1.3",
    "d1.4"
   ]
  },
  "report_kind": {
   "const": "engine-daily"
  },
  "date": {
   "type": "string",
   "format": "date",
   "description": "the session that closed"
  },
  "season": {
   "enum": [
    "S1",
    "S2",
    "S3",
    "off"
   ],
   "description": "S-A earnings season of the date (engine.config.SEASONS)"
  },
  "preflight": {
   "$ref": "#/$defs/preflight"
  },
  "mart": {
   "type": "object",
   "additionalProperties": false,
   "description": "rows appended to the two materialized tables tonight (0 when already present)",
   "required": [
    "daily_contract_rows",
    "earnings_events_rows"
   ],
   "properties": {
    "daily_contract_rows": {
     "type": "integer"
    },
    "earnings_events_rows": {
     "type": "integer"
    }
   }
  },
  "candidates": {
   "type": "array",
   "description": "S-A: events clearing every filter tonight (entry-only rows)",
   "items": {
    "$ref": "#/$defs/sa_position"
   }
  },
  "suppressed": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/sa_suppressed"
   }
  },
  "dropped": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/sa_dropped"
   }
  },
  "graded": {
   "type": "array",
   "description": "S-A signals whose exit was this morning, re-priced from stored legs",
   "items": {
    "$ref": "#/$defs/sa_position"
   }
  },
  "season_running": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/sa_running"
   }
  },
  "ledger": {
   "$ref": "#/$defs/ledger_counts"
  },
  "sb_state": {
   "$ref": "#/$defs/sb_state"
  },
  "exploration": {
   "type": "array",
   "description": "DESIGN/100 \u00a76: the S-A exploration book, one contract per structure for every priceable event in the load band, role = exploration, gate_verdict = first failing filter or PASS",
   "items": {
    "$ref": "#/$defs/sa_position"
   }
  },
  "exploration_dropped": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/sa_dropped"
   }
  },
  "watch_basket": {
   "$ref": "#/$defs/watch_basket"
  }
 },
 "$defs": {
  "preflight": {
   "type": "object",
   "additionalProperties": false,
   "description": "scripts/preflight.py --json; when the subprocess itself fails only ok and warnings are present.",
   "required": [
    "ok",
    "warnings"
   ],
   "properties": {
    "date": {
     "type": "string",
     "format": "date"
    },
    "panel": {
     "type": "object",
     "description": "one entry per UW export group",
     "additionalProperties": {
      "$ref": "#/$defs/panel_entry"
     }
    },
    "truth_set": {
     "type": "object",
     "propertyNames": {
      "enum": [
       "prices",
       "returns",
       "features"
      ]
     },
     "additionalProperties": {
      "$ref": "#/$defs/truth_entry"
     }
    },
    "ok": {
     "type": "boolean"
    },
    "warnings": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "panel_entry": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "present",
    "rows"
   ],
   "properties": {
    "present": {
     "type": "boolean"
    },
    "rows": {
     "type": [
      "integer",
      "null"
     ]
    },
    "error": {
     "type": "string"
    }
   }
  },
  "truth_entry": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "max_date"
   ],
   "properties": {
    "max_date": {
     "type": [
      "string",
      "null"
     ],
     "format": "date"
    },
    "stale_vs_trade_date": {
     "type": "boolean"
    }
   }
  },
  "sa_position": {
   "type": "object",
