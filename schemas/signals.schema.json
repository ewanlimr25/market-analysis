   "required": [
    "ticker",
    "E",
    "pre",
    "post",
    "variant",
    "structure",
    "expiry",
    "k",
    "contracts",
    "notional_usd",
    "credit_entry",
    "credit_net_pct",
    "risk_usd",
    "entry_tier_max",
    "legs_json",
    "call_id",
    "put_id",
    "cap_pass",
    "cap_rank"
   ],
   "properties": {
    "ticker": {
     "type": "string"
    },
    "E": {
     "type": "string",
     "format": "date",
     "description": "the print date"
    },
    "pre": {
