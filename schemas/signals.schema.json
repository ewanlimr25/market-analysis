  "sa_suppressed": {
   "type": "object",
   "additionalProperties": false,
   "description": "An event that failed a filter, with the first failing filter (DESIGN/70 \u00a73.1).",
   "required": [
    "ticker",
    "E",
    "pre",
    "post",
    "variant",
    "first_fail"
   ],
   "properties": {
    "ticker": {
     "type": "string"
    },
    "E": {
     "type": "string",
     "format": "date",
     "description": "the print date"
    },
    "pre": {
     "type": "string",
     "format": "date"
    },
    "post": {
     "type": "string",
     "format": "date"
    },
    "variant": {
     "enum": [
      "A1",
      "A2"
     ]
    },
    "first_fail": {
     "type": "string",
     "pattern": "^(F[1-8]|A2_sector)$"
    },
    "sector": {
     "type": [
      "string",
      "null"
     ]
    },
    "mcap_bucket": {
     "enum": [
      "2-10B",
      "10-50B"
     ]
    },
    "timing": {
     "type": [
      "string",
      "null"
     ]
    },
