    },
    "post": {
     "type": "string",
     "format": "date"
    },
    "variant": {
     "enum": [
      "A1",
      "A2"
     ]
    },
    "structure": {
     "enum": [
      "SS",
      "IC"
     ]
    },
    "expiry": {
     "type": "string",
     "format": "date"
    },
    "k": {
     "type": "number",
     "description": "ATM strike"
    },
    "k_up": {
     "type": [
      "number",
      "null"
     ]
    },
    "k_dn": {
     "type": [
      "number",
      "null"
     ]
    },
    "contracts": {
     "type": "integer",
     "description": "position size in contracts (sizing; DESIGN/70 \u00a73.3)"
    },
    "notional_usd": {
     "type": "number"
    },
    "credit_entry": {
     "type": "number",
     "description": "net premium received per share at entry"
    },
    "debit_exit": {
     "type": [
      "number",
      "null"
     ],
     "description": "per share to close; null until graded"
    },
    "gross_usd": {
     "type": [
      "number",
      "null"
     ]
    },
    "entry_cost_usd": {
     "type": "number"
    },
    "exit_cost_usd": {
     "type": [
      "number",
      "null"
     ]
    },
    "cost_usd": {
     "type": [
      "number",
      "null"
     ]
    },
    "net_usd": {
     "type": [
      "number",
      "null"
     ]
    },
    "n_touches": {
     "type": "integer",
     "description": "legs x 2 (entry and exit touches)"
    },
    "gross_pct": {
     "type": [
      "number",
      "null"
     ]
    },
    "cost_pct": {
     "type": [
      "number",
      "null"
     ]
    },
    "net_pct": {
     "type": [
      "number",
      "null"
     ],
     "description": "net P&L / notional; null until graded"
    },
    "credit_net_pct": {
